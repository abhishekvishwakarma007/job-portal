# Copy to .env for local (non-Docker) runs. docker compose supplies these itself.
# Every value here is validated at startup — a bad one crashes the app on boot
# rather than letting it serve traffic in a degraded state.

# Must be >= 32 chars and must not look like a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres only — the schema uses Postgres-specific types.
DATABASE_URL=postgresql+psycopg://jobportal:jobportal@localhost:5432/jobportal

# development | test | production   (production disables /docs)
ENVIRONMENT=development

# Comma-separated CORS allow-list. Wildcards are rejected: refresh tokens ride
# in a cookie, and credentialed requests cannot use "*".
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=15
